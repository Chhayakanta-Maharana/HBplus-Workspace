# ==============================================================================
# HB+ Workspace - Environment Configuration
# Copy this file to .env and fill in your Firebase & Google OAuth credentials.
# Never commit .env to version control.
# ==============================================================================

# Allowed corporate email domain (without leading @)
# Change to gmail.com for local testing if you do not have an @hbplus.fit account
EXPO_PUBLIC_ALLOWED_DOMAIN=hbplus.fit

# Permanent Fixed Admin Account (auto-provisions on first login)
EXPO_PUBLIC_FIXED_ADMIN_EMAIL=admin@hbplus.fit
EXPO_PUBLIC_FIXED_ADMIN_PASSWORD=Admin@123

# Firebase Web App Configuration (Firebase Console -> Project Settings -> General)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Google OAuth 2.0 Client IDs (Google Cloud Console -> APIs & Services -> Credentials)
# Required for native (Android / iOS) login via expo-auth-session
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
