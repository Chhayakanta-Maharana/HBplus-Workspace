{
  "expo": {
    "name": "HB+ Workspace",
    "slug": "hbplus-workspace",
    "scheme": "hbplusworkspace",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/hbplus-logo.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1220",
    "splash": {
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fit.hbplus.workspace"
    },
    "android": {
      "package": "fit.hbplus.workspace",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/hbplus-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "26c6598f-f44c-43ac-984d-0ca1f2f7cdb0"
      }
    },
    "owner": "chhayakanta"
  }
}
